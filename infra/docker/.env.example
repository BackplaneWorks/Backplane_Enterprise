# Backplane Enterprise — Self-Hosted Docker Compose Configuration
# Copy to .env and replace all placeholder values before running `docker compose up -d`.

POSTGRES_DB=backplane_enterprise
POSTGRES_ADMIN_USER=bp_admin
POSTGRES_ADMIN_PASSWORD=replace-with-strong-admin-password
BP_APP_DB_USER=bp_app
BP_APP_DB_PASSWORD=replace-with-strong-app-password

# Local KEK format required by bp-ent-core: <kek_id>:<32-byte-base64>
# Generate with: echo "v1:$(openssl rand -base64 32)"
BP_KEK=v1:replace-with-32-byte-base64-key

# Public origin of the web portal (used for CORS allowlist & CSRF Origin check).
# NOTE: Compose serves plain HTTP on :8080 for local evaluation; in production
# place a TLS-terminating reverse proxy in front, set https://... and BP_INSECURE_COOKIES=0.
BP_PUBLIC_ORIGIN=http://localhost:8080
BP_API_BASE_URL=http://localhost:8080
BP_INSECURE_COOKIES=1

# MinIO root (used only by minio & minio-init) + bucket-scoped service account for `api`
MINIO_ROOT_USER=bpminio_root
MINIO_ROOT_PASSWORD=replace-with-strong-minio-root-password
S3_BUCKET=bp-ent-artifacts
S3_REGION=us-east-1
S3_ACCESS_KEY=bpapp_s3_access_key
S3_SECRET_KEY=replace-with-strong-s3-app-secret

# Optional Stripe, Mail & SES integrations
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_SEAT_PRICE_ID=
# Metered Stripe price on meter `boat_vm_minutes` (set transform_quantity[divide_by]=60 for hourly pricing)
STRIPE_VM_PRICE_ID=
STRIPE_VM_METER_EVENT=boat_vm_minutes
GOOGLE_MAIL_CLIENT_ID=
GOOGLE_MAIL_CLIENT_SECRET=
MICROSOFT_MAIL_CLIENT_ID=
MICROSOFT_MAIL_CLIENT_SECRET=
MICROSOFT_MAIL_TENANT=common
BP_SES_REGION=
BP_SES_FROM=

WEB_PORT=8080
RELAY_MTLS_PORT=8443
BP_RELAY_MTLS_HOST=localhost
BP_RELAY_IDLE_TIMEOUT_SECS=900
BP_RELAY_DISABLED=0
BP_TRUSTED_PROXY_HOPS=0
RUST_LOG=info
